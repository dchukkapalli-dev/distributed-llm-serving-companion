    value: "10.5281/zenodo.20423002"
    description: "Concept DOI on Zenodo (always resolves to the latest version)"
  - type: doi
    value: "10.5281/zenodo.20423049"
    description: "Version DOI on Zenodo for v1.0.1"
authors:
